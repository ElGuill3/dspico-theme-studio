{
  "name": "dspico-theme-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Offline Material and Custom theme authoring studio for DSpico.",
  "type": "commonjs",
  "main": ".vite/build/main.js",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "test": "vitest run --config vitest.config.mts",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write --print-width 120 --trailing-comma all \"apps/**/*.{ts,tsx,html}\" \"packages/**/*.{ts,tsx,json}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,yml,mts,mjs,ts}\" pnpm-workspace.yaml",
    "format:check": "prettier --check --print-width 120 --trailing-comma all \"apps/**/*.{ts,tsx,html}\" \"packages/**/*.{ts,tsx,json}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,yml,mts,mjs,ts}\" pnpm-workspace.yaml",
    "test:e2e": "vite build --config vite.e2e.config.mts && vite build --config vite.e2e.main.config.mts && tsc -p tsconfig.base.json --noEmit && playwright test e2e",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "verify:package": "electron-forge package && node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron-forge/plugin-vite": "^7.8.3",
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "eslint": "^9.22.0",
    "fast-check": "^4.0.0",
    "playwright": "^1.52.0",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.4.0"
  }
}
